# StudyS459 Environment Variables
APP_NAME=StudyS459
ENV=development
SECRET_KEY=dev-secret-key-change-in-prod-32chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./studys459.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Open decisions - configurable
MASTERY_CORRECT_WEIGHT=1.0
MASTERY_WRONG_PENALTY=0.3
MASTERY_DECAY_DAYS=30
MASTERY_MIN_ATTEMPTS_FOR_MASTERY=3
SCORING_FORMULA=standard
DIFFICULTY_WEIGHTING_ENABLED=true
DIFFICULTY_WEIGHTS=1:1.0,2:1.2,3:1.5
SPACED_REPETITION_STRATEGY=simple
REVIEW_INTERVAL_DAYS=1,3,7,14,30
RECENT_QUESTION_EXCLUSION_DAYS=7
EXAM_INFLUENCE_ON_MASTERY=0.5

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REPORT_TIMES=08:00,20:00

TIMEZONE_DEFAULT=Asia/Tehran
