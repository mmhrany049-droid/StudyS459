# Copy to .env and adjust. See app/config.py for all settings.
APP_NAME=SS459 Study System
ENV=dev
DEBUG=false

# SQLite by default. For postgres: postgresql+psycopg://user:pass@localhost:5432/ss459
DATABASE_URL=sqlite:///./ss459.db

# User-facing timezone (spec 13: Asia/Tehran)
TIMEZONE=Asia/Tehran

LOG_LEVEL=INFO
LOG_FORMAT=text

# Comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Single-user MVP (see 18_OPEN_DECISIONS #9 — auth method TBD, kept simple)
SINGLE_USER_ID=1
